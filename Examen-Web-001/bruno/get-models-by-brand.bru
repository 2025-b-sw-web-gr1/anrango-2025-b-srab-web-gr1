meta {
  name: Get Models by Brand
  type: http
  seq: 6
}

get {
  url: http://localhost:3000/brands/1/models
  body: none
  auth: none
}

docs {
  # Obtener modelos de una marca
  
  Este endpoint devuelve todos los modelos de una marca específica.
  
  ## Parámetros:
  - **id**: ID de la marca (number)
  
  ## Ejemplo de respuesta exitosa:
  ```json
  {
    "statusCode": 200,
    "data": [
      {
        "id": 1,
        "name": "Galaxy S23",
        "year": 2023
      }
    ]
  }
  ```
}
