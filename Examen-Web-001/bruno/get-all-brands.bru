}

get {
  url: http://localhost:3000/brands
  body: none
  auth: none
}

docs {
  # Obtener todas las marcas
  
  Este endpoint devuelve todas las marcas registradas con sus modelos.
  
  ## Ejemplo de respuesta exitosa:
  ```json
  {
    "statusCode": 200,
    "data": [
      {
        "id": 1,
        "name": "Samsung",
        "country": "Corea del Sur",
        "models": [...]
      }
    ]
  }
  ```
}
