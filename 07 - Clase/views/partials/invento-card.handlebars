<div class="invento-card">
    <div class="invento-icon">{{icono}}</div>
    <h3 class="invento-nombre">{{nombre}}</h3>
    <p class="invento-descripcion">{{descripcion}}</p>
    
    <div class="invento-details">
        <div class="detail-section">
            <h4>⚙️ Funcionamiento</h4>
            <p>{{funcionamiento}}</p>
        </div>
        
        <div class="detail-section">
            <h4>💡 Utilidad</h4>
            <p>{{utilidad}}</p>
        </div>
    </div>
    
    <div class="invento-id">ID: {{id}}</div>
</div>
